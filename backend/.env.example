# ===========================================
# Alert System Backend - Environment Variables
# ===========================================

# Database (Supabase Pooler)
# Format: postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres

# DATABASE_URL 이 없을 때만 쓰는 분리형 접속 정보 (database.config.ts 의 두 번째 경로)
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=alert_user
# DATABASE_PASSWORD=alert_password
# DATABASE_NAME=alert_system

# Supabase
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NODE_ENV=development
PORT=3001
USE_SQLITE=true

# Authentication
JWT_SECRET=your-jwt-secret

# Redis (for BullMQ - optional)
REDIS_HOST=localhost
REDIS_PORT=6379

# External APIs
AIR_QUALITY_API_KEY=your-air-quality-api-key
SUBWAY_API_KEY=your-subway-api-key
# 지하철 실시간 도착: 없으면 SUBWAY_API_KEY 로 폴백한다
# SUBWAY_REALTIME_API_KEY=your-subway-realtime-api-key
# WEATHER_API_KEY=your-weather-api-key
# BUS_API_KEY=your-bus-api-key

# Web Push (VAPID)
# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key

# Solapi (알림톡)
# https://console.solapi.com 에서 발급
SOLAPI_API_KEY=your-solapi-api-key
SOLAPI_API_SECRET=your-solapi-api-secret
SOLAPI_PF_ID=your-kakao-channel-pfid
SOLAPI_TEMPLATE_ID=your-alimtalk-template-id

# SQLite (로컬 개발용)
SQLITE_DATABASE=./database.sqlite

# CORS / 프론트엔드
# 배포 도메인을 넣지 않으면 브라우저가 API 호출을 막는다
# CORS_ORIGIN=https://frontend-xi-two-52.vercel.app
# OAuth 성공 후 돌아갈 곳 (기본값 http://localhost:5173)
# FRONTEND_URL=http://localhost:5173

# Google OAuth
# 셋 다 없으면 /auth/google 경로가 비활성화된다
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# 스케줄러 트리거 인증
# 없으면 POST /scheduler/trigger 와 POST /insights/recalculate 가 항상 401 이다
# = EventBridge 가 알림을 못 쏜다. 프로덕션은 SSM /alert-system/prod/scheduler-secret.
# SCHEDULER_SECRET=your-scheduler-secret

# AWS EventBridge Scheduler (스마트 출발 알림)
# AWS_REGION=ap-northeast-2
# AWS_ACCOUNT_ID=your-aws-account-id
# SCHEDULE_GROUP_NAME=alert-system-prod-alerts
# SCHEDULER_ROLE_ARN=arn:aws:iam::[account]:role/[role]
# SCHEDULER_DLQ_ARN=arn:aws:sqs:ap-northeast-2:[account]:[queue]

# NHN Cloud 알림톡 (Solapi 와 별개 경로)
# NHN_CLOUD_APP_KEY=your-nhn-app-key
# NHN_CLOUD_SECRET_KEY=your-nhn-secret-key
# NHN_CLOUD_SENDER_KEY=your-nhn-sender-key
# NHN_CLOUD_SENDER_NUMBER=your-sender-number

# 기타 (기본값이 있어 보통 건드리지 않는다)
# DB_POOL_SIZE=5              # 프로덕션 기본 10, 그 외 5
# DB_SYNCHRONIZE=false        # true 로 켜면 엔티티가 스키마를 덮어쓴다
# QUEUE_ENABLED=false         # BullMQ 큐 사용 여부
# SUPABASE_PROJECT2_DB_URL=   # DATABASE_URL 이 없을 때의 폴백
